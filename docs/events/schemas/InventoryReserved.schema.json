{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://order-fulfillment-lab.example/events/InventoryReserved.schema.json",
  "title": "InventoryReserved payload",
  "description": "docs/events/event-catalog.md §3 — InventoryReserved. Published by Inventory Service on inventory.events, consumed by Order Service. This schema covers only the envelope's `payload` field, not the envelope itself.",
  "type": "object",
  "additionalProperties": true,
  "required": ["orderId", "reservationId", "items", "reservedAt"],
  "properties": {
    "orderId": { "type": "string" },
    "reservationId": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["sku", "quantity"],
        "properties": {
          "sku": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "reservedAt": { "type": "string", "format": "date-time" }
  }
}
