{
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "implementer|investigator|verifier|platform",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/mark-agent-start.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer|investigator|verifier|platform",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/require-agent-report.py",
            "timeout": 30,
            "statusMessage": "Checking agent report..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-ai-attribution.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-subagent-merge-deploy.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
